{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operit 编辑器高亮配置 v1",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "extend",
        "replace"
      ]
    },
    "styles": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 80
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string",
            "minLength": 1
          },
          "light": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "dark": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "bold": {
            "type": "boolean"
          },
          "italic": {
            "type": "boolean"
          },
          "underline": {
            "type": "boolean"
          },
          "strike": {
            "type": "boolean"
          }
        }
      }
    },
    "scopes": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "scope",
          "style"
        ],
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "maxLength": 256
          },
          "style": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "definitions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,79}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rules"
      }
    },
    "extensions": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "pattern": "^\\.[^/\\\\\\s]+$"
      }
    },
    "fileNames": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\]+$"
      }
    }
  },
  "$defs": {
    "rules": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "match"
            ],
            "additionalProperties": false,
            "properties": {
              "match": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "style": {
                "type": "string",
                "minLength": 1
              },
              "ignoreCase": {
                "type": "boolean"
              },
              "captures": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]{0,2})$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "words"
            ],
            "additionalProperties": false,
            "properties": {
              "words": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "style": {
                "type": "string",
                "minLength": 1
              },
              "ignoreCase": {
                "type": "boolean"
              },
              "captures": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]{0,2})$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "literals"
            ],
            "additionalProperties": false,
            "properties": {
              "literals": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "style": {
                "type": "string",
                "minLength": 1
              },
              "ignoreCase": {
                "type": "boolean"
              },
              "captures": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]{0,2})$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "include"
            ],
            "additionalProperties": false,
            "properties": {
              "include": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "language"
            ],
            "additionalProperties": false,
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "begin",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "begin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "style": {
                "type": "string",
                "minLength": 1
              },
              "ignoreCase": {
                "type": "boolean"
              },
              "end": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "contentStyle": {
                "type": "string",
                "minLength": 1
              },
              "beginCaptures": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]{0,2})$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "endCaptures": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]{0,2})$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "endLast": {
                "type": "boolean"
              },
              "rules": {
                "$ref": "#/$defs/rules"
              }
            }
          }
        ]
      }
    },
    "global": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/properties/version"
        },
        "styles": {
          "$ref": "#/properties/styles"
        },
        "scopes": {
          "$ref": "#/properties/scopes"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "replace"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "rules"
        ],
        "properties": {
          "rules": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
